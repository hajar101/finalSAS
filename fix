                break;


            case "9":

                console.log(
                    "\n--- TRI PAR NOM ---"
                );

                afficherliste(trierparnom());

                lancerMenu();

                break;


            case "0":

                console.log("\nAu revoir !");

                rl.close();

                break;


            default:

                console.log("Choix invalide.");

                lancerMenu();
        }
    });
}

lancerMenu();